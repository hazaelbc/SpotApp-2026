{
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://spotapp-2026.onrender.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
